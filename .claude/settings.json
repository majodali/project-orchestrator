{
  "extraKnownMarketplaces": {
    "project-orchestrator": {
      "source": {
        "source": "github",
        "repo": "majodali/project-orchestrator"
      }
    }
  },
  "enabledPlugins": {
    "orchestrator@project-orchestrator": true
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/plugin/scripts/session_start.ts\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__project-orchestrator__task_close",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/plugin/scripts/task_cost_hook.ts\"",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
